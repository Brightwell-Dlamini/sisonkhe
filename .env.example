# -----------------------------------------------------------------------------
# Sisonkhe In Transit — Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to .env.local for development.
# Never commit .env.local.
# -----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# --- Upstash Redis (rate limits, hot cache) ---------------------------------
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- QR Signing -------------------------------------------------------------
# Generate with: openssl rand -base64 48
QR_HMAC_SECRET=

# --- Legacy fleet blob (being phased out) -----------------------------------
# Enable server-side secret enforcement for /api/fleet/sync
FLEET_SYNC_REQUIRE_SECRET=false
FLEET_SYNC_SECRET=
FLEET_API_DEBUG=false

# --- Optional Vercel KV (legacy blob only) ----------------------------------
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Feature Flags ----------------------------------------------------------
# When true, new event-log sync is preferred over the legacy blob path
NEXT_PUBLIC_USE_EVENT_SYNC=true
