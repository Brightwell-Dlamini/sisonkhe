# Sisonkhe In Transit — Environment Variables
# Copy to .env.local for local development.
# Set these in the Vercel project dashboard for preview/production.

# Optional: shared secret for fleet sync write protection
# FLEET_SYNC_SECRET=change-me-to-a-long-random-string

# Set to "true" only after the client sends X-Fleet-Sync-Secret on POST
# FLEET_SYNC_REQUIRE_SECRET=false

# Optional: enable verbose API logging (true/false)
# FLEET_API_DEBUG=false

# Future: Vercel KV / Upstash Redis (when ready to replace in-memory store)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=

# Future: Auth.js / NextAuth
# AUTH_SECRET=
# AUTH_URL=https://your-domain.vercel.app
