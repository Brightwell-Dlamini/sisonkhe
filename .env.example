# -----------------------------------------------------------------------------
# Sisonkhe In Transit — Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to .env.local for development.
# Never commit .env.local.
# -----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# --- Upstash Redis (rate limits, hot cache) ---------------------------------
# REQUIRED in production — rate limits fail closed without these.
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- QR Signing -------------------------------------------------------------
# Generate with: openssl rand -base64 48
QR_HMAC_SECRET=

# --- Vercel Cron ------------------------------------------------------------
# Required for /api/super/invariants/cron, /api/cron/compliance-digest,
# and /api/cron/payment-reconcile. Vercel injects Authorization: Bearer …
CRON_SECRET=

# --- Payment webhooks (REQUIRED in production) ------------------------------
# Providers must send Authorization: Bearer <secret> or X-Webhook-Secret.
# Generate with: openssl rand -base64 32
MOMO_WEBHOOK_SECRET=
EMLANGENI_WEBHOOK_SECRET=

# Optional MoMo / e-Mlangeni API credentials (see provider modules)
# MOMO_SUBSCRIPTION_KEY=
# MOMO_API_USER=
# MOMO_API_KEY=
# MOMO_BASE_URL=
# MOMO_TARGET_ENVIRONMENT=
# MOMO_CALLBACK_URL=
# EMLANGENI_API_KEY=
# EMLANGENI_MERCHANT_ID=
# EMLANGENI_BASE_URL=
# EMLANGENI_CALLBACK_URL=

# --- Legacy fleet blob (being phased out) -----------------------------------
# Prefer event-log sync. REQUIRE_SECRET defaults to true (fail closed).
# Set REQUIRE_SECRET=false only for local legacy client testing.
FLEET_SYNC_REQUIRE_SECRET=true
FLEET_SYNC_SECRET=
FLEET_API_DEBUG=false

# --- Optional Vercel KV (legacy blob only) ----------------------------------
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Feature Flags ----------------------------------------------------------
# When true, new event-log sync is preferred over the legacy blob path
NEXT_PUBLIC_USE_EVENT_SYNC=true
