# -----------------------------------------------------------------------------
# Sisonkhe In Transit — Environment Variables
# -----------------------------------------------------------------------------
# Copy to .env.local for local development. Never commit real secrets.
#
# Required for a minimal local stack:
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#   SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, QR_HMAC_SECRET, CRON_SECRET
# -----------------------------------------------------------------------------

# === Application =============================================================
NODE_ENV=development
# Canonical public origin (links, QR verify URLs). On Vercel, falls back to
# https://$VERCEL_URL when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Prefer event-log sync over legacy fleet blob (clients + UI feature flag)
NEXT_PUBLIC_USE_EVENT_SYNC=true

# === Supabase ================================================================
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — server only; bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Drizzle migrate / studio)
# Dashboard → Project Settings → Database → URI
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# === QR signing ==============================================================
# HMAC secret for signed vehicle / operator / driver QR tokens.
# Generate: openssl rand -base64 48
QR_HMAC_SECRET=

# === Cron (Vercel) ===========================================================
# Authorization: Bearer $CRON_SECRET on all /api/cron/* and /api/super/invariants/cron
# Generate: openssl rand -base64 32  (min 16 chars)
CRON_SECRET=

# === Rate limiting (Phase 6) =================================================
# Off by default so staging/ops are not locked out.
# Set RATE_LIMIT_ENABLED=1 in production after Upstash is configured.
RATE_LIMIT_ENABLED=
# Shared Redis (recommended when limits are on)
# https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# When set, reject requests if Redis is missing (default is fail-open + memory)
RATE_LIMIT_FAIL_CLOSED=

# === Payments ================================================================
# When true, live MoMo / e-Mlangeni providers are offered (if credentials set).
# When false/unset, only the manual (ledger) provider is enabled.
PAYMENTS_LIVE=false

# Webhook auth — providers must send Authorization: Bearer <secret>
# or X-Webhook-Secret. Generate: openssl rand -base64 32
MOMO_WEBHOOK_SECRET=
EMLANGENI_WEBHOOK_SECRET=

# --- MTN MoMo Collections (optional until PAYMENTS_LIVE=true) ---------------
# https://momodeveloper.mtn.com/
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
# Public HTTPS callback the provider POSTs to (usually your /api/payments/webhooks/momo)
MOMO_CALLBACK_URL=

# --- e-Mlangeni / Eswatini Mobile (optional until PAYMENTS_LIVE=true) ---------
EMLANGENI_API_KEY=
EMLANGENI_MERCHANT_ID=
EMLANGENI_BASE_URL=
EMLANGENI_CALLBACK_URL=

# === Legacy fleet blob (DEPRECATED) ==========================================
# Prefer /api/sync/* event-log protocol. Sunset target ~2026-11-01.
# FLEET_SYNC_REQUIRE_SECRET defaults to true (fail closed) unless set false.
FLEET_SYNC_REQUIRE_SECRET=true
# Generate: openssl rand -base64 32  (min 16 chars when required)
FLEET_SYNC_SECRET=
FLEET_API_DEBUG=false

# Optional Vercel KV for legacy blob persistence (else in-memory per instance)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# === Observability (optional) ================================================
# Emit debug-level structured logs in production
LOG_DEBUG=

# === Platform (set automatically on Vercel — do not set locally) =============
# VERCEL_URL=
# VERCEL_REGION=
# VERCEL_GIT_COMMIT_SHA=

# === Optional / historical ===================================================
# NextAuth-style names kept for reference if any tooling expects them.
# Primary session is Supabase Auth (cookie via @supabase/ssr).
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000
