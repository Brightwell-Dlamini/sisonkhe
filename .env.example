# Sisonkhe In Transit — Environment Variables
# Copy to .env.local for local development.
# On Vercel: Project Settings → Environment Variables

# --- Fleet sync write protection (optional) ---
# FLEET_SYNC_SECRET=change-me-to-a-long-random-string
# Set to "true" only after the client sends X-Fleet-Sync-Secret on POST
# FLEET_SYNC_REQUIRE_SECRET=false

# --- Debug ---
# FLEET_API_DEBUG=false

# --- Durable store (Vercel KV) ---
# Create via: Vercel Dashboard → Storage → KV → Create → Connect to project
# These are injected automatically when the store is linked:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
# KV_URL=

# --- Future: Auth.js ---
# AUTH_SECRET=
# AUTH_URL=https://your-domain.vercel.app
