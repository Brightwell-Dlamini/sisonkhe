# -----------------------------------------------------------------------------
# Sisonkhe In Transit — Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to .env.local for development.
# Never commit .env.local.
# -----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Phase 2a) ----------------------------------------------------
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# --- Upstash Redis (Phase 1) ------------------------------------------------
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth (Phase 1) ---------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- QR Signing (Phase 1) ---------------------------------------------------
# Generate with: openssl rand -base64 32
QR_HMAC_SECRET=

# --- MTN MoMo (Phase 4b) ----------------------------------------------------
# Get from your MTN business account manager
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CALLBACK_URL=

# --- Feature Flags ----------------------------------------------------------
# Enable server-side secret enforcement for /api/fleet/sync
FLEET_SYNC_REQUIRE_SECRET=false
FLEET_SYNC_SECRET=

# Verbose logging for fleet store operations
FLEET_API_DEBUG=false
