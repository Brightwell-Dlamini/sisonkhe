  residential_address text NOT NULL,
  home_tel_no text DEFAULT 'N/A'::text,
  cell_no text NOT NULL,
  id_number text NOT NULL,
  chief_of_area text NOT NULL,
  indvuna text NOT NULL,
  marital_status text NOT NULL DEFAULT 'Single'::text,
  partner_name text,
  number_of_kids integer NOT NULL DEFAULT 0,
  next_of_kin_full_name text NOT NULL,
  next_of_kin_relationship text NOT NULL,
  next_of_kin_contact_number text NOT NULL,
  region text NOT NULL,
  agreement_accepted boolean NOT NULL DEFAULT true,
  registration_date text NOT NULL,
  field_officer_name text,
  notes text,
  photo_storage_path text,
  signature_storage_path text,
  photo_data_url text,
  signature_data_url text,
  created_at bigint NOT NULL,
  updated_at bigint NOT NULL,
  synced_at bigint,
  sync_status text NOT NULL DEFAULT 'synced'::text,
  server_created_at timestamp with time zone DEFAULT now(),
