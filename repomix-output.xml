              <strong class="mono highlight">${esc(doc.permitExpiryDate)}</strong>
            </div>
            <div class="validity-row">
              <span class="label">Status</span>
              <strong class="mono">${esc(doc.permitStatus)}</strong>
            </div>
          </div>
        </aside>
      </section>

      <!-- Conditions & signatures -->
      <footer class="permit-footer">
        <div class="conditions">
          <div class="conditions-title">Statutory Conditions:</div>
          <ol>
