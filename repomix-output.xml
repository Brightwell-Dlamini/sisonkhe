"use client";

import { useSearchParams } from "next/navigation";
import { Suspense } from "react";
import Link from "next/link";
import LinkAssignmentPanel from "@/components/assignments/LinkAssignmentPanel";

function LinkInner() {
  const params = useSearchParams();
