        await refresh();
        return {
          success: true,
          newMasterBalance: data.newMasterBalance,
          masterReceiptRef: data.masterReceiptRef,
        };
      } catch (err) {
        return {
          success: false,
          error: err instanceof Error ? err.message : "Network error",
        };
      }
    },
    [refresh]
  );

  return { card, transactions, loading, error, refresh, toggleFreeze, sendMoney };
}
