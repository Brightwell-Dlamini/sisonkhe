    if (!text.trim() || !selectedDriver) return;
    setSending(true);
    await send(selectedDriver.name, selectedDriver.phone, text.trim());
    setText("");
    setSending(false);
  };

  const PRESETS = [
    "Please proceed to the loading bay now.",
