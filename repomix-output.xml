            Auto-Switching Display Timer
          </h3>
        </div>
        <p className="text-xs text-zinc-500">
          Seconds between kiosk display rotations. Range: 3–60.
        </p>
        <div className="flex gap-2">
          <input
            type="number"
            min={3}
            max={60}
            value={config.cycle_timer_seconds ?? 12}
